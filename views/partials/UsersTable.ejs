<table>
  <thead>
    <tr>
      <th>NOME USUARIO</th>
      <th>SENHA</th>
      <th>TIPO DE PERFIL</th>
      <th>ATIVO</th>
      <th>DESATIVAR</th>
    </tr>
  </thead>
  <tbody>
    <% let qtd_posts = pag*5 %>
    <!-- LISTAGEN DE 5 em 5 POSTS -->
       <% let i = qtd_posts-5; for (i = qtd_posts-5 ; i< qtd_posts; i++) { %>
        <% if (i < dados.length) { %>
        <tr>
          <td><%= dados[i].username %></td>
          <td><%= dados[i].password %></td>
          <td><%= dados[i].tipo_perfil %></td>
          <td>
            <% if (dados[i].ativo == 1) {%>
              Ativo
              <% } else {%>
              Desativado     
              <% }%>
          </td>
          <td>
            <% if (dados[i].tipo_perfil == 'ADM') {%>
                Seu Perfil
              <% } else if (dados[i].ativo == 1) {%>
          <a href="/desativarUsuario/<%=dados[i].id%>"
             onclick="return confirm('Tem Certeza Que Deseja Desativar o Perfil?');">
             Desativar Perfil
          </a>
          <% } else {%>
                <a href="/reativarUsuario/<%=dados[i].id%>" 
                  onclick="return confirm('Tem Certeza Que Deseja Reativar o Perfil?');">
                    Reativar Perfil
              <% }%>
              </td>
        </tr>
        <% } %>
        <% } %>
        </tbody>
        
    <tfoot>
      <tr>
          <td colspan="2" style="text-align: center;">
          <% if (pag > 1) {%>
          <a href="/pagUsuarios/<%= Number(pag) - 1 %>">⬅</a>
          <% } %>
          </td>
          <td colspan="1" style="text-align: center;">
          <% if (dados.length > 5) {%>
          <%= pag %>
          <% } %>
          </td>
          <td colspan="2" style="text-align: center;">
          <% if (qtd_posts < dados.length) {%>
          <a href="/pagUsuarios/<%= Number(pag) + 1  %>">⮕</a>
          <% } %>
          </td>
      </tr>
    </tfoot>
    <!-- SE EXISTIREM 5 POSTS OU MENOS -->
  
</table>