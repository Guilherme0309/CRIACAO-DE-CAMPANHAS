<table>
  <thead>
    <tr>
      <th>NOME TURMA</th>
      <th>TIPO DE PERFIL</th>
      <th>ATIVO</th>
      <th>DESATIVAR</th>
    </tr>
  </thead>
  <tbody>
    <% let qtd_posts = pag*5 %>
    <!-- LISTAGEN DE 5 em 5 POSTS -->
       <% let i = qtd_posts-5; for (i = qtd_posts-5 ; i< qtd_posts; i++) {%>
        <% if (i < dados.length) {%>
        <tr>
          <td><%= dados[i].sigla %></td>
          <td><%= dados[i].tipo_perfil %></td>
          <td><%= dados[i].ativo %></td>
          <td><a href=/dadosDaTurma/<%=dados.id%>>Desativar Turma</a></td>
        </tr>
         <% } %>
         <% } %>
        </tbody>
    <tfoot>
      <tr>
          <td colspan="5">
          <% if (pag > 1) {%>
          <a href="/pagTurmas/<%= Number(pag) - 1 %>">⬅</a>
          <% } %>
          <% if (qtd_posts < dados.length) {%>
          <a href="/pagTurmas/<%= Number(pag) + 1  %>">⮕</a>
          <% } %>
        </td>
      </tr>
    </tfoot>
    <!-- SE EXISTIREM 5 POSTS OU MENOS -->
  
</table>