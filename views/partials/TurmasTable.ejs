<table>
  <thead>
    <tr>
      <th>SIGLA TURMA</th>
      <th>DOCENTE</th>
      <th>ATIVO</th>
      <th>DESATIVAR</th>
    </tr>
  </thead>
  <tbody>
    <% let qtd_posts = pag*5 %>
    <!-- LISTAGEN DE 5 em 5 POSTS -->
       <% let i = qtd_posts-5; for (i = qtd_posts-5 ; i< qtd_posts; i++) {%>
        <% if (i < dados.length) {%>
        <tr>
          <td><%= dados[i].sigla %></td>
          <td><%= dados[i].docente %></td>
          <td>
            <% if (dados[i].ativo == 1) {%>
              Ativo
              <% } else {%>
              Desativado     
              <% }%>
          </td>
          <td>
            <% if (dados[i].ativo == 1) {%>
              <a href=/desativarturmas/<%=dados[i].id_turma%> 
                onclick="return confirm('Tem Certeza Que Deseja Desativar a Turma?');">
                Desativar Turma
              </a>
            </td>
              <% } else {%>
                <a href=/reativarturmas/<%=dados[i].id_turma%>
                  onclick="return confirm('Tem Certeza Que Deseja Reativar a Turma?');">
                  Reativar Turma
                </a>
              </td>   
              <% }%>
        </tr>
         <% } %>
         <% } %>
        </tbody>
    <tfoot>
      <tr>
          <td colspan="1" style="text-align: center;">
          <% if (pag > 1) {%>
          <a href="/pagTurmas/<%= Number(pag) - 1 %>">⬅</a>
          <% } %>
          </td>
          <td colspan="2" style="text-align: center;">
          <% if (dados.length > 5) {%>
          <%= pag %>
          <% } %>
          </td>
          <td colspan="1" style="text-align: center;">
          <% if (qtd_posts < dados.length) {%>
          <a href="/pagTurmas/<%= Number(pag) + 1  %>">⮕</a>
          <% } %>
          </td>
      </tr>
    </tfoot>
    <!-- SE EXISTIREM 5 POSTS OU MENOS -->
  
</table>