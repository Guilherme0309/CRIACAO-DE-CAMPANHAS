<table>
  <thead>
    <tr>
      <th>DESCRIÇÃO</th>
      <th>PONTOS</th>
      <th>ATIVO</th>
      <th>DESATIVAR</th>
    </tr>
  </thead>
  <tbody>
    <% let qtd_posts = pag*5 %>
    <!-- LISTAGEN DE 5 em 5 POSTS -->
       <% let i = qtd_posts-5; for (i = qtd_posts-5 ; i< qtd_posts; i++) {%>
        <% if (i < dados.length) {%>
        <tr>
          <td><%= dados[i].Descricao %> 
          </td>
          <td><%= dados[i].Pontos %> Pontos</td>
          <td>
            <% if (dados[i].Ativo == 1) {%>
              Ativo
            <%} else if (dados[i].Ativo == 0) {%>
              Desativado
            <% } %>
            
          </td>
          <td><% if (dados[i].Ativo == 1) {%>
              <a href="/desativarItem/<%= idCampanha%>/<%=dados[i].id%>" 
              onclick="return confirm('Tem Certeza Que Deseja Desativar o Item?');">
                Desativar Item
              </a>
              <% } else {%>
                <a href="/reativarItem/<%= idCampanha%>/<%=dados[i].id%>" 
                  onclick="return confirm('Tem Certeza Que Deseja Reativar o Item?');">
                    Reativar Item
              <% }%>
              </td>
        </tr>
         <% } %>
         <% } %>
        </tbody>
    <tfoot>
      <tr>
          <td colspan="1" style="text-align: center;">
          <% if (pag > 1) {%>
          <a href="/editItens/<%= idCampanha%>/<%= Number(pag) - 1 %>">⬅</a>
          <% } %>
          </td>
          <td colspan="2" style="text-align: center;">
          <% if (dados.length > 5) {%>
          <%= pag %>
          <% } %>
          </td>
          <td colspan="1" style="text-align: center;">
          <% if (qtd_posts < dados.length) {%>
          <a href="/edit/<%= idCampanha%>/<%= Number(pag) + 1  %>">⮕</a>
          <% } %>
          </td>
      </tr>
    </tfoot>
    <!-- SE EXISTIREM 5 POSTS OU MENOS -->
  
</table>