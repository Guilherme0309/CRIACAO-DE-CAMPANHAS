<!DOCTYPE html>
<html lang="en">

<%- include("../partials/head") %>

<style>
    main {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 30px; /* espaço entre os botões */
    }

    main a {
        display: inline-block;
        background-color: #0b1d80;
        color: white;
        text-decoration: none;
        font-weight: bold;
        padding: 15px 0; /* altura do botão */
        width: 250px; /* largura fixa igual para todos */
        text-align: center;
        border-radius: 50px;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.3);
        transition: transform 0.2s, box-shadow 0.2s;
    }

    main a:hover {
        transform: translateY(-3px);
        box-shadow: 0px 6px 14px rgba(0, 0, 0, 0.4);
    }
</style>

<body>
    <%- include("../partials/menu") %>
    <a href="/selectCampanha"><img src="../../static/voltar.png" alt="Voltar" width="2.5%" style="margin: 10px;"></a>

    <main>
        <a href="/tabGeral/<%=idCampanha%>/1">TABELA GERAL</a>

        <% if (req.session.loggedin) { %>
            <a href="/nova-doacao/<%=idCampanha%>">NOVA DOAÇÃO</a>
        <% } %>

        <% if (req.session.adm) { %>
        <a href="/editItens/<%=idCampanha%>/1">EDITAR ITENS</a>
        <% } %>
        <br>
    </main>
    
    <%- include("../partials/footer") %>
</body>

</html>
