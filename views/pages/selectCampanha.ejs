<!DOCTYPE html>
<html lang="en">

<%- include("../partials/head") %>

<body>
    <%- include("../partials/menu") %>
    <% console.log ('Dados: ' + JSON.stringify(dados))%>
    <a href="/pagInicialADM"><img src="../../static/voltar.png" alt="Voltar" width="3%"></a>
    <center><h1>SELECIONAR CAMPANHA</h1></center>
    <br><br>
    <main>
        <center>
        <% if (!dados || dados.length === 0)  {%>
            Nenhuma Campanha Criada
        <% } else {%>
                <select name="qtd" id="qtd" style="width: 200px;">
                    <option value="">[Escolha]</option>
                    <% dados.forEach(dado => { %>
                        <option value="<%= dado.id_Campanha %>"><%= dado.nome_Campanha %></option>
                    <% }) %>
                </select>
            <% } %>
            <br><br>
        <% if (req.session.adm){ %>
            <a href="/novaCampanha"><button>CRIAR NOVA CAMPANHA</button></a>
        <% } %>  
        </center>
    </main>

    <%- include("../partials/footer") %>
</body>

</html>