<!DOCTYPE html>
<html lang="en">


<%- include("../partials/head") %>
<!-- Inclui o cabeçalho padrão (head.ejs) -->

<body>
    <%- include("../partials/menu") %>
    <!-- Inclui o menu padrão do sistema (menu.ejs) -->

    <% console.log ('Dados: ' + dados)%>
    

    <!-- Botão de voltar para a página inicial do ADM -->
    <a href="/pagInicialADM">
        <img src="../../static/voltar.png" alt="Voltar" width="3%">
    </a>

    
    <center><h1>SELECIONAR CAMPANHA</h1></center>

    <br><br>
    <main>
        <center>
            <% if (!dados || dados.length === 0)  { %>
                <!-- Caso não existam campanhas criadas -->
                Nenhuma Campanha Criada
            <% } else { %>
                <!-- Caso existam campanhas, renderiza um <select> com as opções -->
                <select name="qtd" id="qtd" style="width: 200px;">
                    <option value="">[Escolha]</option>
                    <% dados.forEach(dado => { %>
                        <option value="<%= dado %>"><%= dado %></option>
                    <% }) %>
                </select>
            <% } %>

            <br><br>

            <% if (req.session.adm) { %>
                <!-- Se o usuário logado for ADM, exibe botão para criar nova campanha -->
                <a href="/novaCampanha">
                    <button>CRIAR NOVA CAMPANHA</button>
                </a>
            <% } %>  
        </center>
    </main>

    <%- include("../partials/footer") %>
    <!-- Inclui o rodapé padrão (footer.ejs) -->
</body>
</html>
