<!DOCTYPE html>
<html lang="en">

<%- include("../partials/head") %>

<body>
    <%- include("../partials/menu") %>
    <% console.log ('Dados: ' + JSON.stringify(dados))%>
    <% if (req.session.adm){ %>
    <a href="/pagInicialADM"><img src="../../static/voltar.png" alt="Voltar" width="3%" style="margin: 10px;"></a>
    <% } %> 
    <center><h1>SELECIONAR CAMPANHA</h1></center>
    <br><br>
    <main>
        <center>
        <% if (!dados || dados.length === 0)  {%>
            Nenhuma Campanha Criada
        <% } else {%>

            <form action="/selectCampanha" method="post" onsubmit="
                const selectedCampanha = document.getElementById('selectedCampanha');

                if (!selectedCampanha.value){
                    alert('Selecione uma Turma para prosseguir!!');
                    return false;
                }">

                <select name="selectedCampanha" id="selectedCampanha" style="width: 200px;">
                    <option value="">[Escolha]</option>
                    <% dados.forEach(dado => { %>
                        <option value="<%= dado.id_Campanha %>"><%= dado.nome_Campanha %></option>
                    <% }) %>
                </select>

            <% } %>
            <br><br>
            <button type="submit" id="btnCriar" style="margin:0 20px;">CONFIRMAR</button>
        </form>
        <% if (req.session.adm){ %>
            <a href="/novaCampanha"><button style="margin-top: 20px;">CRIAR NOVA CAMPANHA</button></a>
        <% } %>  
        </center>
    </main>

    <%- include("../partials/footer") %>
</body>

</html>