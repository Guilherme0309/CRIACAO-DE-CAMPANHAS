<!DOCTYPE html>
<html lang="en">

<%- include("../partials/head") %>

<body>
  <a href="/selectCampanha"><img src="../../static/voltar.png" alt="Voltar" width="2.5%" style="margin: 10px;"></a>
  <br><br>
  <center>
    <img src="../../static/Logo.png" width="250px">
    <h1 id="h1Login">LOGIN</h1>
    <main>
      <form action="/login" method="post" class="formItens">
        <table id="tblLogin">
          <tr>
            <td>
              Login:
            </td>
            <td>
              <input type="text" name="username" id="username" placeholder="Digite seu nome de usuário" maxlength="20">
            </td>
          </tr>
          <tr>
            <td>
              Senha:
            </td>
            <td>
              <div id="viewSenha">
                <input type="password" name="password" id="passwordLogin" placeholder="Digite sua senha" maxlength="20">
                <button type="button" onclick="viewSenha()">
                  <img src="../../static/verSenha.png" alt="Ver senha" id="iconeOlho" width="45px">
                </button>
              </div>

            </td>
          </tr>
        </table>
        <br>
        <br>
        <button type="submit" id="btnEntrar" style="margin-bottom: 20px;">ENTRAR</button>
      </form>
    </main>
  </center>

  <script>
    function viewSenha() {
      const senha = document.getElementById("passwordLogin");
      const icone = document.getElementById("iconeOlho");
      if (senha.type === "password") {
        senha.type = "text";
        icone.src = "../../static/ocultarSenha.png";
      } else {
        senha.type = "password";
        icone.src = "../../static/verSenha.png";
      }
    }
  </script>

  <%- include("../partials/footer") %>
</body>

</html>