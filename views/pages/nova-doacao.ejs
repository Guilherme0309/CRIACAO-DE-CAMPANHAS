<!DOCTYPE html>
<html lang="en">


<%- include("../partials/head") %>
<!-- Inclui o cabeçalho padrão (head.ejs)  -->

<body>
    <%- include("../partials/menu") %>
    <!-- Inclui o menu padrão do sistema (menu.ejs) -->

    <center>
      

        <h1 id="h1Login">NOVA DOAÇÃO</h1>
        <!-- Título principal da página -->

        <main>
            <!-- Conteúdo principal da página -->

            <!-- Formulário de cadastro de nova doação -->
            <form action="/nova-doacao" method="post" 
            onsubmit="
            // Script de validação antes de enviar o formulário
            const id_turma = document.getElementById('id_turma').value;
            const id_roupa = document.getElementById('id_roupa').value;
            const qtd = document.getElementById('qtd').value;
        
            // Verifica se todos os campos foram preenchidos
            if (!id_turma || !id_roupa || !qtd) {
              alert('Preencha Todos os Campos para Postar a Arrecadação!');
              return false; // Impede o envio do formulário
            }

            // Confirmação final antes de gravar
            return confirm('Tem Certeza Que Deseja Adicionar uma Arrecadação?');" 
            class="formItens">

            <table id="tblPost">
                <!-- Campo para selecionar a turma doadora -->
                <tr>
                    <td>TURMA DOADORA:</td>
                    <td>
                        <select name="id_turma" id="id_turma" style="width: 200px;">
                            <option value="">[Escolha]</option>
                            <% let i = 0; for (i = 0 ; i < turmas.length; i++) { %>
                                <!-- Exibe as turmas disponíveis (sigla + docente) -->
                                <option value="<%= turmas[i].id_turma %>">
                                    <%= turmas[i].sigla %> - [<%= turmas[i].docente %>]
                                </option>
                            <% } %>
                        </select>
                    </td>
                </tr>

                
                <tr><td><br></td><td><br></td></tr>

                <!-- Campo para selecionar o item a ser doado -->
                <tr>
                    <td>QUAL ITEM SERÁ DOADO:</td>
                    <td>
                        <select name="id_roupa" id="id_roupa" style="width: 200px;">
                            <option value="">[Escolha]</option>
                            <% let x = 0; for (x = 0 ; x < pontuacoes.length; x++) { %>
                                <!-- Exibe os itens cadastrados com descrição e pontuação -->
                                <option value="<%= pontuacoes[x].id %>">
                                    <%= pontuacoes[x].Descricao %> - <%= pontuacoes[x].Pontos %> Pontos
                                </option>
                            <% } %>
                        </select>
                    </td>
                </tr>

               
                <tr><td><br></td><td><br></td></tr>

                <!-- Campo para selecionar a quantidade de itens -->
                <tr>
                    <td>QUANTIDADE DE ITENS:</td>
                    <td>
                        <select name="qtd" id="qtd" style="width: 200px;">
                            <option value="">[Escolha]</option>
                            <% let z = 1; for (z = 1 ; z < 100; z++) { %>
                                <!-- Exibe opções de 1 até 99 -->
                                <option value="<%= z %>"><%= z %></option>
                            <% } %>
                        </select>
                    </td>
                </tr>
            </table>

            <br><br>
            <!-- Botão para gravar a arrecadação -->
            <button type="submit" id="btnPost" style="margin-bottom: 20px;">
                GRAVAR ARRECADAÇÃO
            </button>
            </form>
        </main>
    </center>

    <%- include("../partials/footer") %>
    <!-- Inclui o rodapé padrão (footer.ejs) -->
</body>
</html>
