<!DOCTYPE html>
<html lang="en">



<%- include("../partials/head") %>

<body>
    <%- include("../partials/menu") %>
    <a href="/selectCampanha"><img src="../../static/voltar.png" alt="Voltar" width="3%"></a>
    <center><h1>NOVA CAMPANHA</h1></center>
    <br><br>
    <main>
        <center>
            <form action="/novaCampanha" method="post" class="formItens"
            onsubmit="
            const id_turmas = document.getElementById('Turmas').value;
            const nome_campanha = document.getElementById('campanhaname').value;
        
        if (!id_turmas || !nome_campanha) {
          alert('Preencha Todos os Campos para Postar a Campanha!');
          return false;
        }
        return confirm('Tem Certeza Que Deseja Adicionar uma Campanha?');" >
            <table id="tblLogin">
                <tr>
                    <td>
                        <b>Nome Campanha:</b>
                    </td>
                    <td>
                        <input type="text" name="campanhaname" id="campanhaname" placeholder="Digite o nome da Campanha">
                    </td>
                </tr>
                <tr>
                    <td><br></td>
                    <td><br></td>
                </tr>
                <tr>
                    <td style=" text-align: left;">
                        <b>Turmas:</b>
                    </td>
                    <td>
                        <div id="CheckedList" style="border:1px solid #ccc;height:150px;width:300px;overflow-y:scroll;padding:2px;">
                            <% turmas.forEach(turma => { %>
                                <input type="checkbox" id="Turmas" name="Turmas" value="<%= turma.id_turma %>" class="turma" checked="true">
                                <label><%= turma.sigla %> - [<%= turma.docente %>]</label>
                                <br>
                            <% }) %>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td style=" text-align: left;">
                        <br>
                        <b>Adicionar Itens:</b>
                    </td>
                    <td></td>
                </tr>
                <tr>
                    <td style=" text-align: left;">
                        <br>
                        Descrição Item: 
                    </td>
                    <td>
                        <input type="text" id="itemName" placeholder="Digite o nome do Item">
                    </td>
                </tr>
                <tr>
                    <td style=" text-align: left;">
                        Pontos:
                    </td>
                    <td>
                        <br>
                        <select id="DdlPontos" style="width: 200px;">
                            <option value="">[Escolha]</option>
                            <% let x = 1; for (x = 1 ; x< 100; x++) {%>
                                <option value="<%= x %>"><%= x %> Pontos</option>
                            <% } %>
                          </select>
                    </td>
                </tr>
            </table>
            <button id="addTask" type="button">ADICIONAR ITEM</button>

            <ul id="listaItens" name="itensName">
            </ul>
            <br>
            <br>
            <button type="submit" id="btnCriar" style="margin-bottom: 20px;">CRIAR</button>
                </form>
            </main>
        </center>
        </center>
    </main>

    <script>
        const ItemInput = document.getElementById("itemName");
        const selectPontos = document.getElementById("DdlPontos")
        const listaItens = document.getElementById("listaItens");
        const btnItens = document.getElementById("addTask");
        const btnRemover = document.getElementById("removeTesk")
        
        function AddItem(){
        
            const descItem = ItemInput.value.trim();
            const pontosItem = selectPontos.value;
        
            if (descItem === "" || pontosItem === ""){
                alert("Por favor, digite o nome do Item e Pontos!");
                return;
            }
        
            const li = document.createElement("li");
            li.textContent = descItem + "   " + pontosItem + " Pontos"; 

            const inputItemDesc = document.createElement("input");
            inputItemDesc.setAttribute("type", "hidden");
            inputItemDesc.setAttribute("name", "ItemName");
            inputItemDesc.setAttribute("value", descItem);

            const inputItemPontos = document.createElement("input");
            inputItemPontos.setAttribute("type", "hidden");
            inputItemPontos.setAttribute("name", "ItemPontos");
            inputItemPontos.setAttribute("value", pontosItem);
            
            const deleteBtn = document.createElement("button");
            deleteBtn.textContent = "X";
            deleteBtn.classList.add("delete-btn");
        
            deleteBtn.addEventListener("click", (event) => {
                event.stopPropagation(); 
                listaItens.removeChild(li);
            });
        
            li.appendChild(deleteBtn);
            li.appendChild(inputItemDesc);
            li.appendChild(inputItemPontos);
            listaItens.appendChild(li);
        
            ItemInput.value = "";
            selectPontos.value = ""

        }
        
        btnItens.addEventListener ("click", AddItem);
        
        ItemInput.addEventListener("keypress", (event) =>{
            if (event.key === "Enter"){
                AddItem();
            }
        })
    </script>

    <%- include("../partials/footer") %>
</body>

</html>